# local | dev | demo
APP_ENV=local

# SQLAlchemy URL (psycopg 3). On DO add ?sslmode=require. May go through the PgBouncer pool.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/leaklens
# Direct (not pooled) URL for LangGraph's checkpointer and store
DATABASE_URL_DIRECT=postgresql://USER:PASSWORD@localhost:5432/leaklens
# session | transaction (set transaction when DATABASE_URL uses DO's PgBouncer in transaction mode)
DB_POOL_MODE=session

# local | spaces
STORAGE_BACKEND=local
SPACES_ENDPOINT=https://blr1.digitaloceanspaces.com
SPACES_REGION=blr1
SPACES_BUCKET=leaklens-files
SPACES_KEY=
SPACES_SECRET=

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
MODEL_REASONING=claude-sonnet-5-5
MODEL_FAST=claude-haiku-5-5

VOYAGE_API_KEY=
EMBED_MODEL=voyage-3.5
EMBED_DIMS=1024

LANGSMITH_API_KEY=
LANGSMITH_PROJECT=leaklens
LANGSMITH_TRACING=false

JWT_SECRET=replace-with-a-random-64-char-string
JWT_EXPIRE_MINUTES=480
# false only for local http development
COOKIE_SECURE=true

CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
